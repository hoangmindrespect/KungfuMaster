  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d9c29c6692f544c418b3b7fb4f6181e1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
  - Welcome you to this world!
  - Now I have some instructions for you.
  - If you want to move, just pressing the 4 direction arrows in your keyboard.
  - Press A, S to attack.
  - Press D to flash.
  - Press U to open the character's stats table.
  - Press I to open your inventory.
  - If you want to use the item in your inventory, just click it and then click on
    the button on that details table of that item.
  - Press E to interact with other NPCs.
  - That's all things you need to know. Now you can start your adventure!!!
  name: The Watcher
